# Copy to .env (`make setup` does this for you and generates SECRET_KEY).
# Values in the real environment take precedence over this file.

# ---------------------------------------------------------------- Django ----
SECRET_KEY=
# Use srcs_core.settings_prod for production (DEBUG off, secure cookies).
# DJANGO_SETTINGS_MODULE=srcs_core.settings

# Comma-separated. To open the app from another machine (e.g. the host of a VM)
# add the VM's IP or hostname here and in CSRF_TRUSTED_ORIGINS.
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1],0.0.0.0,192.168.56.10
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://192.168.56.10:8000

# Public base URL used in links generated by the app (tournament invitations).
# SITE_URL=http://localhost:8000

# Only set to true when the site is served over HTTPS; secure cookies are not
# stored by browsers on plain http://<ip> URLs and login would fail.
# SECURE_COOKIES=false

# ---------------------------------------------------------------- Server ----
# BIND_ADDRESS=0.0.0.0
# PORT=8000
# Set to false if a reverse proxy (see nginx/pong.conf) serves /static/ or /media/.
# SERVE_STATIC=true
# SERVE_MEDIA=true
# Where uploaded avatars are stored (default data/media).
# MEDIA_ROOT=data/media

# ------------------------------------------------------- 42 intra OAuth -----
# Needed for "Login with 42". Create an app at https://profile.intra.42.fr/oauth/applications
# with redirect URI <SITE_URL>/oauth2/login/redirect/
AUTH_URL_INTRA=
REDIRECT_URI=http://localhost:8000/oauth2/login/redirect/
CLIENT_ID=
CLIENT_SECRET=

# ------------------------------------------------------------- Bot user -----
# The chat bot / admin account is created as "<BOT_USERNAME> (BOT)".
# Without a password it cannot log in to /admin.
# BOT_USERNAME=pong
# BOT_PASSWORD=

# ------------------------------------------------ Optional: PostgreSQL ------
# By default a SQLite database is stored in data/db.sqlite3 (SQLITE_PATH).
# Setting POSTGRES_HOST switches to PostgreSQL.
# SQLITE_PATH=data/db.sqlite3
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_NAME=transcendence
# POSTGRES_USER=transcendence
# POSTGRES_PASSWORD=

# ----------------------------------------------------- Optional: Redis ------
# By default an in-memory channel layer is used, which requires the single
# server process started by scripts/start.sh. Set REDIS_URL to use Redis.
# REDIS_URL=redis://127.0.0.1:6379/0
