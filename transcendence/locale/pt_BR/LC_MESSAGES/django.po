#: srcs_auth/services.py
msgid "Open Google Authenticator, tap \"+\" and choose \"Scan a QR code\". Or choose \"Enter a setup key\" and type the key below."
msgstr "Abra o Google Authenticator, toque em \"+\" e escolha \"Ler código QR\". Ou escolha \"Inserir chave de configuração\" e digite a chave abaixo."

#: srcs_auth/services.py
msgid "Open Authy, tap \"+\" (Add account) and choose \"Scan QR code\". Or choose \"Enter key manually\" and type the key below."
msgstr "Abra o Authy, toque em \"+\" (Adicionar conta) e escolha \"Escanear código QR\". Ou escolha \"Inserir chave manualmente\" e digite a chave abaixo."

